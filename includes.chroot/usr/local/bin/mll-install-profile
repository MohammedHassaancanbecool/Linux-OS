#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PROFILE=${1:-}
case "$PROFILE" in
  network|web|passwords|wireless|forensics|reverse|exploitation|redteam) ;;
  *) echo "Usage: sudo $0 {network|web|passwords|wireless|forensics|reverse|exploitation|redteam}" >&2; exit 2 ;;
esac
[ "$(id -u)" -eq 0 ] || { echo 'Run with sudo.' >&2; exit 1; }
command -v apt-get >/dev/null 2>&1 || { echo 'This profile installer requires Debian/Ubuntu apt.' >&2; exit 1; }
if [ -f "/usr/local/share/mll/package-profiles/$PROFILE.list" ]; then
  LIST="/usr/local/share/mll/package-profiles/$PROFILE.list"
else
  LIST="$ROOT/config/package-profiles/$PROFILE.list"
fi
[ -f "$LIST" ] || { echo "Missing profile: $PROFILE" >&2; exit 1; }
export DEBIAN_FRONTEND=noninteractive
apt-get update
available=''
missing=''
while IFS= read -r package; do
  package=${package%%#*}
  package=$(printf '%s' "$package" | tr -d '[:space:]')
  [ -n "$package" ] || continue
  if apt-cache policy "$package" 2>/dev/null | awk '$1 == "Candidate:" && $2 != "(none)" { found=1 } END { exit !found }'; then
    available="$available $package"
  else
    missing="$missing $package"
  fi
done < "$LIST"
if [ -n "$available" ]; then
  # Package names are normalized from the image's controlled profile files.
  # shellcheck disable=SC2086
  apt-get install -y --no-install-recommends $available
fi
printf '%s\n' "Installed available packages for profile: $PROFILE"
if [ -n "$missing" ]; then
  printf '%s\n' "Not available in the configured repositories (review separately):$missing"
fi
