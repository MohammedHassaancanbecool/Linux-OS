#!/bin/sh
set -eu
marker=/var/lib/drakonis/.default-password-set
if [ -e "$marker" ]; then exit 0; fi
if id drakonis >/dev/null 2>&1; then
  usermod -p '$6$drakonis$lTciYnPfIPv9gFoa/sx31cwSeBbtkPzsQgdG8dizYW0B78.iH0ByLpZtgGC.utR5oiQhfPg6KwlsG9xMli.Bk1' drakonis
  install -d -m 0755 /var/lib/drakonis
  : > "$marker"
  chmod 0600 "$marker"
  systemctl disable drakonis-initial-password.service >/dev/null 2>&1 || true
fi
