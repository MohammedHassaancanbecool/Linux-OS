[Unit]
Description=Initialize the Drakonis demonstration account password once
After=live-config.service systemd-user-sessions.service
ConditionPathExists=!/var/lib/drakonis/.default-password-set

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/drakonis-initial-password
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
