#!/bin/sh
set -eu
# Apply the visual defaults for the current XFCE session.
xfconf-query -c xsettings -p /Net/ThemeName -s DRAKONIS-Night 2>/dev/null || true
xfconf-query -c xfwm4 -p /general/theme -s DRAKONIS-Night 2>/dev/null || true
xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/image-path -s /usr/share/backgrounds/drakonis-linux/Drakonis-Linux.png 2>/dev/null || true
# Start the visual dock once per session.
if command -v plank >/dev/null 2>&1 && ! pgrep -x plank >/dev/null 2>&1; then
  nohup plank >/dev/null 2>&1 &
fi
