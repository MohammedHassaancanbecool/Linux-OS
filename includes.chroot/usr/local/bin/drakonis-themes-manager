#!/bin/sh
set -eu
printf '\033[1;36mDrakonis Themes Manager\033[0m\n\n'
printf '1) DRAKONIS-Night (Indigo/Cyan)\n2) DRAKONIS-Carbon (Graphite/Teal)\nChoose [1-2, default 1]: '
read choice
[ "$choice" = 2 ] && theme=DRAKONIS-Carbon || theme=DRAKONIS-Night
if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface gtk-theme "$theme" 2>/dev/null || true
  gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null || true
  printf 'Applied %s to the GNOME session.\n' "$theme"
else
  printf 'Theme selected: %s. Apply it from GNOME Settings when running outside a desktop session.\n' "$theme"
fi
printf 'Press Enter to close... '; read _
