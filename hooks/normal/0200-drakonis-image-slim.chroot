#!/bin/sh
set -eu
# Keep English and Arabic in the live image; remove other locale catalogs.
find /usr/share/locale -mindepth 1 -maxdepth 1 \
  ! -name 'en' ! -name 'en_*' ! -name 'ar' ! -name 'ar_*' \
  -exec rm -rf {} +
# Replace the large offline GNOME help catalog and viewer with a web shortcut.
# Also remove optional desktop applications that task-gnome-desktop may recommend.
apt-get purge -y gnome-user-docs yelp yelp-xsl libyelp0 \
  firefox-esr gnome-software gnome-tweaks gnome-disk-utility \
  file-roller gnome-screenshot >/dev/null 2>&1 || true
# Ensure the web replacement is present even when live-build follows a
# symlinked config/includes.chroot tree, and remove leftover documentation.
rm -rf /usr/share/yelp /usr/share/yelp-xsl /usr/share/doc/gnome-user-docs \
  /usr/share/doc/yelp /usr/share/doc/yelp-xsl
rm -f /usr/share/applications/yelp.desktop /usr/share/man/man1/yelp.1.gz \
  /usr/share/pkgconfig/yelp-xsl.pc
cat > /usr/share/applications/drakonis-gnome-help-web.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=GNOME Help (Web)
Comment=Open the official GNOME Help website
Exec=/usr/bin/xdg-open https://help.gnome.org/
Icon=help-browser
Terminal=false
Categories=GNOME;Documentation;Utility;
StartupNotify=true
EOF
# Package archives are not needed after the live image is assembled.
rm -f /var/cache/apt/archives/*.deb /var/cache/apt/archives/partial/* 2>/dev/null || true
